# ---------------------------------------------------------
# Section 2: Wire subgroups as members of parent groups
# e.g. cn=dc-heroes becomes a uniqueMember of cn=heroes
# Applications doing recursive group lookup will resolve
# batman -> dc-heroes -> heroes automatically.
# ---------------------------------------------------------

dn: cn=deceased,ou=groups,dc=comics,dc=ldap
changetype: modify
add: uniqueMember
uniqueMember: cn=dc-deceased,ou=groups,dc=comics,dc=ldap
uniqueMember: cn=marvel-deceased,ou=groups,dc=comics,dc=ldap
-

dn: cn=heroes,ou=groups,dc=comics,dc=ldap
changetype: modify
add: uniqueMember
uniqueMember: cn=dc-heroes,ou=groups,dc=comics,dc=ldap
uniqueMember: cn=marvel-heroes,ou=groups,dc=comics,dc=ldap
-

dn: cn=living,ou=groups,dc=comics,dc=ldap
changetype: modify
add: uniqueMember
uniqueMember: cn=dc-living,ou=groups,dc=comics,dc=ldap
uniqueMember: cn=marvel-living,ou=groups,dc=comics,dc=ldap
-

dn: cn=neutral,ou=groups,dc=comics,dc=ldap
changetype: modify
add: uniqueMember
uniqueMember: cn=dc-neutral,ou=groups,dc=comics,dc=ldap
uniqueMember: cn=marvel-neutral,ou=groups,dc=comics,dc=ldap
-

dn: cn=villains,ou=groups,dc=comics,dc=ldap
changetype: modify
add: uniqueMember
uniqueMember: cn=dc-villains,ou=groups,dc=comics,dc=ldap
uniqueMember: cn=marvel-villains,ou=groups,dc=comics,dc=ldap
-
