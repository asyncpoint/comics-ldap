dn: cn=dc-neutral,ou=groups,dc=comics,dc=ldap
objectClass: top
objectClass: groupOfUniqueNames
cn: dc-neutral
description: Neutral Characters from DC Comics
uniqueMember: cn=dc-neutral,ou=groups,dc=comics,dc=ldap

dn: cn=dc-living,ou=groups,dc=comics,dc=ldap
objectClass: top
objectClass: groupOfUniqueNames
